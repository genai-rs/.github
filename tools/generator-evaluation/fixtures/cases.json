    {
      "id": "stream.chunked-sse",
      "layer": "sdk_transport",
      "operation_id": "stream",
      "wire_input": {
        "method": "GET",
        "path": "/stream",
        "response_status": 200,
        "content_type": "text/event-stream",
        "chunks_utf8": [
          "data: {\"type\":\"response.output_text.delta\",\"delta\":\"h",
          "é\"}\r\n\r",
          "\n: keepalive\n\ndata: [DONE]\n\n"
        ],
        "repeat_with_every_byte_split": true
      },
      "expected": {
        "events": [
          {
            "type": "response.output_text.delta",
            "delta": "hé"
          }
        ],
        "terminal": "done",
        "events_after_done": 0
      },
      "pass_criterion": "Use local mock; repeat splitting the UTF-8 bytes at every position, including within é. Deliver exactly one typed event, ignore comment heartbeat, recognize DONE and close once without buffering the whole body."
    },
